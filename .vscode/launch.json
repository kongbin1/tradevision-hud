{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TradeVision HUD",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${userHome}/AppData/Local/TradeVisionHUD/venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TradeVision HUD (데모)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--demo"],
      "python": "${userHome}/AppData/Local/TradeVisionHUD/venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
